cmake_minimum_required(VERSION 3.30)
# Standalone CPack configuration: package only the curated deployment directory.
foreach(required SOURCE_DIR BUILD_DIR STAGE_DIR OUTPUT_DIR)
    if(NOT DEFINED ${required})
        message(FATAL_ERROR "Missing ${required}")
    endif()
    file(TO_CMAKE_PATH "${${required}}" ${required})
endforeach()
file(READ "${BUILD_DIR}/VERSION.txt" version)
string(STRIP "${version}" version)
if(NOT version MATCHES "^([0-9]+)\\.([0-9]+)\\.([0-9]+)$")
    message(FATAL_ERROR "Installer requires a three-part numeric version: ${version}")
endif()
if(CMAKE_MATCH_1 GREATER 65535 OR CMAKE_MATCH_2 GREATER 65535 OR CMAKE_MATCH_3 GREATER 65535)
    message(FATAL_ERROR "Version exceeds installer version limits: ${version}")
endif()
set(CPACK_PACKAGE_VERSION_MAJOR "${CMAKE_MATCH_1}")
set(CPACK_PACKAGE_VERSION_MINOR "${CMAKE_MATCH_2}")
set(CPACK_PACKAGE_VERSION_PATCH "${CMAKE_MATCH_3}")
include("${CMAKE_CURRENT_LIST_DIR}/InstallerIds.cmake")
set(CPACK_GENERATOR NSIS)
# Standalone packaging has no compiler configuration to supply this value.
set(CMAKE_SIZEOF_VOID_P 8)
set(CPACK_PACKAGE_NAME NextApp)
set(CPACK_PACKAGE_VENDOR "The Last Viking LTD")
set(CPACK_PACKAGE_DESCRIPTION_SUMMARY "NextApp desktop client")
set(CPACK_PACKAGE_VERSION "${version}")
set(CPACK_PACKAGE_FILE_NAME "NextApp-${version}-windows-x64")
set(CPACK_PACKAGE_INSTALL_DIRECTORY NextApp)
set(CPACK_PACKAGE_DIRECTORY "${OUTPUT_DIR}")
set(CPACK_INSTALLED_DIRECTORIES "${STAGE_DIR};/")
set(CPACK_INSTALL_CMAKE_PROJECTS "")
set(CPACK_VERBATIM_VARIABLES TRUE)
set(CPACK_PACKAGE_EXECUTABLES nextapp NextApp)
set(CPACK_PACKAGE_INSTALL_REGISTRY_KEY "${NEXTAPP_NSIS_INSTALLER_ID}")
set(CPACK_NSIS_INSTALL_ROOT "$PROGRAMFILES64")
set(CPACK_NSIS_DISPLAY_NAME NextApp)
set(CPACK_NSIS_PACKAGE_NAME NextApp)
set(CPACK_NSIS_EXECUTABLES_DIRECTORY bin)
set(CPACK_NSIS_INSTALLED_ICON_NAME "bin\\nextapp.exe")
set(CPACK_NSIS_MUI_ICON "${SOURCE_DIR}/src/NextAppUi/icons/nextapp.ico")
set(CPACK_NSIS_MUI_UNIICON "${SOURCE_DIR}/src/NextAppUi/icons/nextapp.ico")
set(CPACK_NSIS_MODIFY_PATH OFF)
set(CPACK_NSIS_ENABLE_UNINSTALL_BEFORE_INSTALL ON)
set(CPACK_NSIS_COMPRESSOR "/SOLID lzma")
set(CPACK_RESOURCE_FILE_LICENSE "${STAGE_DIR}/LICENSE.txt")
# The standard uninstaller removes its recorded payload, leaving user data intact.
include(CPack)
