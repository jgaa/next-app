# Reference only. bootstrap.sh generates .env with independent random passwords.
# All images use latest. Set a unique project name for each installation.
COMPOSE_PROJECT_NAME=nextapp-self-hosted
NEXTAPP_HOST=localhost
NEXTAPP_PORT=10321
NEXTAPP_BIND_ADDRESS=127.0.0.1
SIGNUP_PORT=10322
SIGNUP_BIND_ADDRESS=127.0.0.1
# Advertised protocol; HTTPS is terminated by your external proxy.
SIGNUP_PROTOCOL=http
SIGNUP_PUBLIC_URL=http://localhost:10322
ALLOW_INSECURE_SIGNUP=no
# Replace every placeholder with a different openssl rand -hex 32 value if
# preparing .env manually. Passwords must be 64 hexadecimal characters.
MARIADB_ROOT_PASSWORD=REPLACE_WITH_RANDOM_HEX
MARIADB_NEXTAPP_PASSWORD=REPLACE_WITH_RANDOM_HEX
MARIADB_SIGNUP_PASSWORD=REPLACE_WITH_RANDOM_HEX
SIGNUP_ADMIN_PASSWORD=REPLACE_WITH_RANDOM_HEX
